{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",                        // 1. Tells TS where your source code lives
    "outDir": "./dist",                        // 2. Tells TS where to put the compiled JS files

    // Environment Settings
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,                            // Tells TS to only typecheck, not output files
    "target": "ESNext",
    "types": ["node"],                        // 4. Added "node" here so global node types work flawlessly

    // Other Outputs
    "sourceMap": true,
    // "declaration": true,                    // Commented out: Conflicts with "noEmit": true
    // "declarationMap": true,                 // Commented out: Conflicts with "noEmit": true

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,  // <--- ADDED: Fixes the warning and prevents OS-casing bugs

    // Style Options (Highly recommended for production APIs)
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]                      // 5. Tells the compiler to only look inside your src folder
}